#!/bin/sh
# Picture from Picture launcher for macOS and Linux.
# It expects a Logisim JAR containing com.cburch.logisim.gui.paint.PaintTool.
# Set LOGISIM_JAR or place picture-to-circuit.jar/logisim.jar beside this script or one directory above.

case $0 in
  */*) HERE=$(CDPATH= cd -- "${0%/*}" && pwd) ;;
  *)   HERE=$(pwd) ;;
esac
MAIN=com.cburch.logisim.gui.paint.PaintTool

JAR=${LOGISIM_JAR:-}
if [ -z "$JAR" ]; then
  for candidate in "$HERE/picture-to-circuit.jar" "$HERE/../picture-to-circuit.jar" "$HERE/logisim.jar" "$HERE/../logisim.jar"; do
    if [ -f "$candidate" ]; then JAR=$candidate; break; fi
  done
fi

JAVA=
if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  JAVA=$JAVA_HOME/bin/java
elif command -v java >/dev/null 2>&1 && java -version >/dev/null 2>&1; then
  JAVA=java
fi

if [ -n "$JAVA" ] && [ -n "$JAR" ] && [ -f "$JAR" ]; then
  exec "$JAVA" -Dapple.awt.application.name="Paint from Picture" -cp "$JAR" "$MAIN" "$@"
fi

if [ -z "$JAR" ] || [ ! -f "$JAR" ]; then
  echo "paint-from-picture: set LOGISIM_JAR or put picture-to-circuit.jar/logisim.jar beside this script or one directory above" >&2
elif [ -z "$JAVA" ]; then
  echo "paint-from-picture: Java 8 or newer is required (set JAVA_HOME)" >&2
else
  echo "paint-from-picture: cannot run the configured Logisim JAR" >&2
fi
exit 1
